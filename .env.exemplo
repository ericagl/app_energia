# Configuração do servidor Casa Solar.
# Copie para ".env" (cp .env.exemplo .env) e preencha. O run.sh carrega o .env.
# NUNCA publique o arquivo .env (ele contém a chave do ESP32).

# --- Modo de operação ----------------------------------------------------------
# real          = usa somente as leituras recebidas do ESP32 (padrão)
# demonstracao  = valores fictícios do simulador, com aviso em todas as telas
MODO=real

# --- Recebimento das leituras do ESP32 -------------------------------------------
# Chave que o ESP32 envia no cabeçalho X-API-Key. Sem ela, o recebimento fica
# desligado. Gere uma chave longa e aleatória, por exemplo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# (Opcional) device_id aceitos, separados por vírgula. Vazio = qualquer um.
DISPOSITIVOS_PERMITIDOS=

# Limite de potência plausível (W). Leituras acima disso são recusadas.
MAX_POTENCIA_W=20000

# --- Monitoramento da comunicação -------------------------------------------------
# Sem transmissão há mais de LIMITE_ATRASO_S segundos -> "sem comunicação recente"
# (os valores ao vivo deixam de ser mostrados como atuais). Use pelo menos
# 3x o intervalo de envio do ESP32.
LIMITE_ATRASO_S=60
# Sem transmissão há mais de LIMITE_DESCONEXAO_S segundos -> "desconectado".
LIMITE_DESCONEXAO_S=600

# --- Conta de energia ---------------------------------------------------------------
UNIDADE_NOME="Minha residência"
# Tarifa da sua concessionária em R$/kWh (com impostos). Valor abaixo é ilustrativo.
TARIFA_RS_POR_KWH=0.95
# Dia do mês em que a concessionária faz a leitura (1–31). Vazio = "não informada".
DIA_LEITURA=

# --- Bancos de dados (normalmente não precisa mudar) --------------------------------
# DB_REAL=dados/energia_real.db
# DB_DEMO=dados/energia_demonstracao.db
# LOG_ARQUIVO=dados/ingestao.log

# --- Voz do servidor ------------------------------------------------------------------
TTS_VOZ=pt-BR-FranciscaNeural
